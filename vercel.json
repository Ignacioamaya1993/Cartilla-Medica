{
  "functions": {
    "api/admin.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self' https://cdixkmlvzbrecpgththg.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/server/(.*)",
      "headers": [ { "key": "X-Robots-Tag", "value": "noindex" } ]
    }
  ],
  "rewrites": [
    { "source": "/server/:path*", "destination": "/404.html" }
  ]
}
